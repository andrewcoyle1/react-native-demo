rules_version = '2';

// Everything under users/{uid} is private to that user. Nothing else is granted.
//
// The training collections divide by who authors them. Plans, races and sessions
// are generated server-side through the Admin SDK, which bypasses these rules
// entirely, so the client-facing rule for them is read-only. The two things the
// athlete owns — a session's completion and their schedule — are the only client
// writes, and both are validated field by field.
service cloud.firestore {
  match /databases/{database}/documents {
    // The profile document. Written by the user-provider feature; a missing
    // document is a legitimate state ("absent"), not an error.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'dateOfBirth', 'sex', 'createdAt', 'modifiedAt'])
        && request.resource.data.keys().hasAll(['name', 'dateOfBirth', 'sex', 'createdAt', 'modifiedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.dateOfBirth is timestamp
        && request.resource.data.sex in ['male', 'female', 'other']
        && request.resource.data.createdAt == request.time
        && request.resource.data.modifiedAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        // createdAt is immutable; every other field stays optional so partial
        // edits are a single write rather than a read-modify-write.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'dateOfBirth', 'sex', 'modifiedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.dateOfBirth is timestamp
        && request.resource.data.sex in ['male', 'female', 'other']
        && request.resource.data.modifiedAt == request.time;

      // Deleting a profile would orphan the notes beneath it.
      allow delete: if false;
    }

    // Generated by the backend. The client reads them and never writes.
    match /users/{userId}/plans/{planId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/races/{raceId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/activities/{activityId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // The plan's sessions. Generated by the backend, but the athlete may mark one
    // complete — which is the only field this rule lets a client touch.
    match /users/{userId}/sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completion'])
        && (
          // Un-completing is a legitimate edit, so null is allowed alongside a
          // well-formed completion map.
          request.resource.data.completion == null
          || (
            request.resource.data.completion.keys().hasOnly(['completedAt', 'activityId'])
            && request.resource.data.completion.keys().hasAll(['completedAt'])
            // Pinned to the server's clock rather than the device's, so a wrong
            // phone clock cannot backdate a session.
            && request.resource.data.completion.completedAt == request.time
          )
        );

      allow create, delete: if false;
    }

    // The athlete's own availability and commitments — a single document, which
    // the first edit creates.
    match /users/{userId}/schedule/{scheduleId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && scheduleId == 'current'
        && request.resource.data.keys().hasOnly(['availableMinutes', 'commitments', 'modifiedAt'])
        && request.resource.data.modifiedAt == request.time
        && (
          !('availableMinutes' in request.resource.data.keys())
          || (
            request.resource.data.availableMinutes is list
            && request.resource.data.availableMinutes.size() == 7
          )
        )
        && (
          !('commitments' in request.resource.data.keys())
          || (
            request.resource.data.commitments is list
            && request.resource.data.commitments.size() <= 50
          )
        );

      allow delete: if false;
    }

    match /users/{userId}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow update: if false;
    }
  }
}
