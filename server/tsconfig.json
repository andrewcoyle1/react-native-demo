{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    /* Node strips types rather than compiling them, so every import must carry
       its real extension and nothing TypeScript-only may need transforming. */
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../src/domain/**/*.ts"]
}
