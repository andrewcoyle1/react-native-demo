# Copy to .env. Never commit .env.
DATABASE_URL=postgres://stamina:stamina@localhost:5433/stamina

# `npm test` overrides DATABASE_URL to point at stamina_test, because the suite
# truncates every table before each test. Do not point it at the database above.
PORT=4000

# Signs access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me
