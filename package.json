{
  "name": "firebase-expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/html-elements": "^57.0.0",
    "@expo/ui": "~58.0.0",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "expo": "58.0.0-preview.0",
    "expo-build-properties": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-device": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-glass-effect": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-web-browser": "~58.0.0",
    "mixpanel-react-native": "^3.7.0",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.87.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.1",
    "jpeg-js": "^0.4.4",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_APP_ENV=mock expo start --clear",
    "start:dev": "EXPO_PUBLIC_APP_ENV=dev expo start --clear",
    "start:prod": "EXPO_PUBLIC_APP_ENV=prod expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "start:api": "EXPO_PUBLIC_APP_ENV=api expo start --clear",
    "start:vps": "EXPO_PUBLIC_APP_ENV=api EXPO_PUBLIC_API_URL=https://46-101-9-200.sslip.io expo start --clear",
    "device:ios": "EXPO_PUBLIC_APP_ENV=api EXPO_PUBLIC_API_URL=https://46-101-9-200.sslip.io expo run:ios --device --configuration Release",
    "device:android": "EXPO_PUBLIC_APP_ENV=api EXPO_PUBLIC_API_URL=https://46-101-9-200.sslip.io expo run:android --device --variant release",
    "backdrop:variants": "node scripts/make-backdrop-variants.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"*.{js,mjs,json}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|mixpanel-react-native|@react-native-firebase/.*)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/server/"
    ]
  }
}
