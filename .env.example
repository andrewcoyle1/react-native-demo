# Which environment the bundle is built for: mock | api | dev | prod.
# Metro inlines this at BUILD time, so changing it means restarting with --clear.
EXPO_PUBLIC_APP_ENV=dev

# Mixpanel project tokens. Put the real values in `.env.local`, which is
# gitignored — `.env` is tracked, and prod and dev must not be confused.
#
# These are write-only project tokens, designed by Mixpanel to sit in untrusted
# clients, and Metro inlines them into the bundle either way; the reason to keep
# them out of the repo is correctness, not secrecy.
EXPO_PUBLIC_MIXPANEL_TOKEN_DEV=
EXPO_PUBLIC_MIXPANEL_TOKEN_PROD=

# Mixpanel data residency region: `eu`, `in`, or unset for US (the default).
# This MUST match the project's region — Mixpanel answers "1" to data posted to
# the wrong host and then discards it, so a mismatch looks exactly like success.
EXPO_PUBLIC_MIXPANEL_REGION=
